{
    "audio_config": {"audio": "pipewire"},
    "bootloader": "systemd-boot",
    "hostname": "legion",
    "kernels": ["linux"],
    "locale_config": {
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US.UTF-8"
    },
    "disk_config": {
        "config_type": "manual_partitioning",
        "device_modifications": [{
            "device": "/dev/sda",
            "wipe": true,
            "partitions": [
                {
                    "btrfs": [],
                    "dev_path": null,
                    "flags": ["Boot", "ESP"],
                    "fs_type": "fat32",
                    "mount_options": [],
                    "mountpoint": "/boot",
                    "obj_id": "efi",
                    "size": {"sector_size": {"value": 512, "unit": "B"}, "unit": "MiB", "value": 512},
                    "start": {"sector_size": {"value": 512, "unit": "B"}, "unit": "MiB", "value": 1},
                    "status": "create",
                    "type": "primary"
                },
                {
                    "btrfs": [],
                    "dev_path": null,
                    "flags": [],
                    "fs_type": "ext4",
                    "mount_options": [],
                    "mountpoint": "/",
                    "obj_id": "root",
                    "size": {"sector_size": {"value": 512, "unit": "B"}, "unit": "Percent", "value": 100},
                    "start": {"sector_size": {"value": 512, "unit": "B"}, "unit": "MiB", "value": 513},
                    "status": "create",
                    "type": "primary"
                }
            ]
        }]
    },
    "network_config": {"type": "nm"},
    "ntp": true,
    "packages": [
        "git", "base-devel", "wget", "curl", "vim", "neovim",
        "networkmanager", "linux-headers", "intel-ucode",
        "sof-firmware", "bluez", "bluez-utils", "openssh"
    ],
    "profile_config": {
        "profile": {
            "main": "Minimal"
        }
    },
    "swap": true,
    "timezone": "America/Vancouver"
}
